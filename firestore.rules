rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    match /users/{uid} {
      allow read: if verified() && request.auth.uid == uid;
      allow write: if false;
    }
    match /games/{gameId} {
      allow read: if verified() && resource.data.published == true;
      allow write: if false;
      match /checkpoints/{checkpointId} {
        allow read: if verified() && get(/databases/$(database)/documents/games/$(gameId)).data.published == true;
        allow write: if false;
      }
      match /leaderboard/{sessionId} {
        allow read: if verified() && get(/databases/$(database)/documents/games/$(gameId)).data.published == true;
        allow write: if false;
      }
    }
    match /sessions/{sessionId} {
      allow read: if verified() && request.auth.uid in resource.data.memberIds;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
