# macOS and local Xcode state
.DS_Store
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
**/xcshareddata/WorkspaceSettings.xcsettings

# Private configuration, course answers, and original project archives
**/FirebaseConfig.plist
**/GoogleService-Info.plist
**/Keys.plist
Keys/
/courses/*.private.json
Extra Files/
**/.env*
!**/.env.example

# Generated dependencies, emulator output, and build/test artifacts
**/node_modules/
.firebase/
**/*-debug.log
**/*-debug.*.log
build/
DerivedData/
.build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
/*.gcno

# Prevent accidental reintroduction of the retired CocoaPods cache
Pods/

# Keep the project, shared schemes, and embedded Swift Package Manager workspace
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/project.xcworkspace/xcshareddata/
