########################
# macOS
########################
.DS_Store
**/.DS_Store

########################
# Project junk (your custom folder)
########################
Extra Files/
**/Extra Files/

########################
# Secrets / private config
########################
GoogleService-Info.plist
**/GoogleService-Info.plist
Keys.plist
**/Keys.plist
Keys/
**/Keys/

.env
.env.*
!.env.example
*.pem
*.p12
*.key
*.cer
*.certSigningRequest
*.mobileprovision

########################
# CocoaPods
########################
Pods/
# Keep Podfile.lock tracked (do NOT ignore it)

########################
# Xcode / Swift
########################
## User settings
xcuserdata/

## compatibility with Xcode 8 and earlier
*.xcscmblueprint
*.xccheckout

## build outputs
build/
dist/
DerivedData/
*.moved-aside

## Xcode user-specific files
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

## SwiftPM build artifacts (safe to ignore)
.build/

########################
# Carthage / Accio
########################
Carthage/Build/
Dependencies/
.accio/

########################
# fastlane
########################
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

########################
# Code Injection
########################
iOSInjectionProject/

########################
# Tooling / scratch (scripts, tooling around the project)
########################
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

########################
# Xcode Patch
########################
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata
/*.gcno
**/xcshareddata/WorkspaceSettings.xcsettings
